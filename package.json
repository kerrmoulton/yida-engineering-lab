{
  "name": "yida-engineering-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint labs scripts tests",
    "contract:check": "node scripts/check-contract.mjs",
    "test": "node --test tests/tooling.test.mjs",
    "build:canvas": "node scripts/build-canvas-pages.mjs",
    "build": "npm run build:canvas && node scripts/build.mjs test",
    "guard:live": "node scripts/check-live-baseline.mjs",
    "verify:remote": "node scripts/verify-remote.mjs",
    "publish:test": "npm run build:canvas -- --require-targets && node scripts/publish-page.mjs",
    "guard:tailwind:runtime": "npm run guard:live -- --page tailwind.runtime",
    "guard:tailwind:build": "npm run guard:live -- --page tailwind.buildTime",
    "verify:tailwind:runtime": "npm run verify:remote -- --page tailwind.runtime",
    "verify:tailwind:build": "npm run verify:remote -- --page tailwind.buildTime",
    "publish:tailwind:runtime": "npm run publish:test -- --page tailwind.runtime",
    "publish:tailwind:build": "npm run publish:test -- --page tailwind.buildTime",
    "experiment:tailwind:build": "npm run build:canvas",
    "check": "npm run format:check && npm run lint && npm test && npm run build && npm run contract:check",
    "release:test": "npm run check && npm run publish:test"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.17"
  }
}
