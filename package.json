{
  "name": "yida-engineering-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint labs scripts tests",
    "contract:generate": "node scripts/generate-flowboard-contract.mjs",
    "contract:generated:check": "node scripts/generate-flowboard-contract.mjs --check",
    "contract:check": "node scripts/check-contract.mjs",
    "connector:flowboard:generate": "node scripts/generate-flowboard-connector-actions.mjs",
    "connector:flowboard:check": "node scripts/generate-flowboard-connector-actions.mjs --check",
    "connector:file-import:generate": "node scripts/generate-file-import-connector-actions.mjs",
    "connector:file-import:check": "node scripts/generate-file-import-connector-actions.mjs --check",
    "test": "node --test tests/tooling.test.mjs",
    "test:flowboard": "node --import tsx --test labs/flowboard-fullstack/server/test/*.test.ts",
    "test:flowboard:web": "vitest run --config labs/flowboard-fullstack/vite.config.mjs",
    "test:flowboard:e2e": "playwright test --config labs/flowboard-fullstack/playwright.config.ts",
    "test:flowboard:remote": "node scripts/smoke-flowboard-remote.mjs",
    "test:flowboard:remote:direct": "node scripts/smoke-flowboard-remote.mjs --transport direct",
    "test:flowboard:remote:connector": "node scripts/smoke-flowboard-remote.mjs --transport connector",
    "test:platform": "node --import tsx --test labs/yida-platform-runtime/test/*.test.ts",
    "test:platform:remote": "node scripts/smoke-platform-runtime.mjs",
    "test:platform:native:remote": "node scripts/smoke-platform-native.mjs",
    "test:platform:file-storage:remote": "node scripts/smoke-platform-file-storage.mjs",
    "test:platform:api:remote": "node scripts/smoke-platform-api.mjs",
    "test:platform:crud:remote": "node scripts/smoke-platform-crud.mjs",
    "test:platform:process:remote": "node scripts/smoke-platform-process.mjs",
    "test:platform:js-api-matrix:remote": "node scripts/smoke-platform-js-api-matrix.mjs",
    "run:platform:process:once": "node scripts/run-platform-process-once.mjs",
    "run:platform:process:terminate-once": "node scripts/run-platform-process-terminate-once.mjs",
    "run:platform:process:complete-once": "node scripts/run-platform-process-complete-once.mjs",
    "run:platform:process:delete-once": "node scripts/run-platform-process-delete-once.mjs",
    "run:platform:file-lifecycle:once": "node scripts/run-platform-file-lifecycle-once.mjs",
    "typecheck:flowboard": "tsc -p labs/flowboard-fullstack/tsconfig.server.json && tsc -p labs/flowboard-fullstack/tsconfig.web.json",
    "typecheck:platform": "tsc -p labs/yida-platform-runtime/tsconfig.json",
    "dev:flowboard": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"npm:dev:flowboard:api\" \"npm:dev:flowboard:web\"",
    "dev:flowboard:api": "tsx watch labs/flowboard-fullstack/server/src/index.ts",
    "start:flowboard:api": "tsx labs/flowboard-fullstack/server/src/index.ts",
    "tunnel:flowboard": "npx --yes cloudflared@0.7.3 tunnel --url http://127.0.0.1:4318 --no-autoupdate",
    "reset:flowboard:db": "node --import tsx scripts/reset-flowboard-db.mjs",
    "dev:flowboard:web": "vite --config labs/flowboard-fullstack/vite.config.mjs",
    "build:flowboard:web": "vite build --config labs/flowboard-fullstack/vite.config.mjs",
    "build:canvas": "node scripts/build-canvas-pages.mjs",
    "build": "npm run build:canvas && node scripts/build.mjs test",
    "guard:live": "node scripts/check-live-baseline.mjs",
    "verify:remote": "node scripts/verify-remote.mjs",
    "publish:test": "npm run build:canvas -- --require-targets && node scripts/publish-page.mjs",
    "guard:tailwind:runtime": "npm run guard:live -- --page tailwind.runtime",
    "guard:tailwind:build": "npm run guard:live -- --page tailwind.buildTime",
    "verify:tailwind:runtime": "npm run verify:remote -- --page tailwind.runtime",
    "verify:tailwind:build": "npm run verify:remote -- --page tailwind.buildTime",
    "publish:tailwind:runtime": "npm run publish:test -- --page tailwind.runtime",
    "publish:tailwind:build": "npm run publish:test -- --page tailwind.buildTime",
    "guard:flowboard": "npm run guard:live -- --page flowboard.board",
    "verify:flowboard": "npm run verify:remote -- --page flowboard.board",
    "publish:flowboard": "npm run publish:test -- --page flowboard.board",
    "guard:platform:runtime": "npm run guard:live -- --page platform.runtimeInventory",
    "verify:platform:runtime": "npm run verify:remote -- --page platform.runtimeInventory",
    "publish:platform:runtime": "npm run publish:test -- --page platform.runtimeInventory",
    "guard:platform:native": "npm run guard:live -- --page platform.nativeComponents",
    "verify:platform:native": "npm run verify:remote -- --page platform.nativeComponents",
    "publish:platform:native": "npm run publish:test -- --page platform.nativeComponents",
    "guard:platform:api": "npm run guard:live -- --page platform.apiBridge",
    "verify:platform:api": "npm run verify:remote -- --page platform.apiBridge",
    "publish:platform:api": "npm run publish:test -- --page platform.apiBridge",
    "guard:platform:crud": "npm run guard:live -- --page platform.apiCrud",
    "verify:platform:crud": "npm run verify:remote -- --page platform.apiCrud",
    "publish:platform:crud": "npm run publish:test -- --page platform.apiCrud",
    "guard:platform:process": "npm run guard:live -- --page platform.processSandbox",
    "verify:platform:process": "npm run verify:remote -- --page platform.processSandbox",
    "publish:platform:process": "npm run publish:test -- --page platform.processSandbox",
    "guard:platform:js-api-matrix": "npm run guard:live -- --page platform.jsApiMatrix",
    "verify:platform:js-api-matrix": "npm run verify:remote -- --page platform.jsApiMatrix",
    "publish:platform:js-api-matrix": "npm run publish:test -- --page platform.jsApiMatrix",
    "guard:platform:file-import": "npm run guard:live -- --page platform.fileImportChannels",
    "verify:platform:file-import": "npm run verify:remote -- --page platform.fileImportChannels",
    "publish:platform:file-import": "npm run publish:test -- --page platform.fileImportChannels",
    "experiment:tailwind:build": "npm run build:canvas",
    "check": "npm run format:check && npm run lint && npm run contract:generated:check && npm run connector:flowboard:check && npm run connector:file-import:check && npm run typecheck:flowboard && npm run typecheck:platform && npm test && npm run test:flowboard && npm run test:flowboard:web && npm run test:platform && npm run build && npm run build:flowboard:web && npm run contract:check",
    "check:full": "npm run check && npm run test:flowboard:e2e",
    "release:test": "npm run check && npm run publish:test"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "antd": "^5.29.3",
    "express": "^5.2.1",
    "lucide-react": "^1.37.0",
    "multer": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "overrides": {
    "vite": {
      "esbuild": "0.28.2"
    }
  }
}
