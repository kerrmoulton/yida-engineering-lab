{
  "schemaVersion": 1,
  "application": {
    "key": "engineeringLab",
    "name": "Yida Engineering Lab",
    "appType": null,
    "environment": "test"
  },
  "sourcePolicy": {
    "canvas": "GIT_MANAGED",
    "remoteWrite": "GUARDED",
    "verification": "TOKEN_SCHEMA_READBACK"
  },
  "services": [
    {
      "key": "flowboardApi",
      "name": "Flowboard local API",
      "baseUrl": "http://127.0.0.1:4318/api"
    }
  ],
  "pages": [
    {
      "key": "tailwind.runtime",
      "name": "Tailwind 路径 A · 运行时导入",
      "formUuid": null,
      "formType": "display",
      "managementMode": "GIT_MANAGED",
      "authorSource": "labs/canvas-tailwind/src/TailwindRuntimeImportProbe.canvas.jsx",
      "source": "labs/canvas-tailwind/dist/TailwindRuntimeImportProbe.canvas.jsx",
      "build": {
        "kind": "canvas"
      },
      "contract": "contracts/canvas-runtime-experiment.contract.json",
      "baseline": "release/baselines/tailwind.runtime.test.json"
    },
    {
      "key": "tailwind.buildTime",
      "name": "Tailwind 路径 B · 本地编译",
      "formUuid": null,
      "formType": "display",
      "managementMode": "GIT_MANAGED",
      "authorSource": "labs/canvas-tailwind/src/TailwindBuildTimeProbe.canvas.jsx",
      "source": "labs/canvas-tailwind/dist/TailwindBuildTimeProbe.canvas.jsx",
      "build": {
        "kind": "tailwind",
        "styleEntry": "labs/canvas-tailwind/src/styles.css",
        "config": "labs/canvas-tailwind/tailwind.config.cjs"
      },
      "contract": "contracts/canvas-page.contract.json",
      "baseline": "release/baselines/tailwind.buildTime.test.json"
    },
    {
      "key": "flowboard.board",
      "name": "Flowboard · 全栈联调实验",
      "formUuid": null,
      "formType": "display",
      "managementMode": "GIT_MANAGED",
      "authorSource": "labs/flowboard-fullstack/web/src/Flowboard.canvas.tsx",
      "source": "labs/flowboard-fullstack/dist/Flowboard.canvas.jsx",
      "build": {
        "kind": "esbuild-canvas"
      },
      "contract": "contracts/flowboard-canvas.contract.json",
      "baseline": "release/baselines/flowboard.board.test.json"
    }
  ]
}
