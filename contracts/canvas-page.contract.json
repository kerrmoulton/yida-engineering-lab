{
  "schemaVersion": 1,
  "sourceExtension": ".canvas.jsx",
  "entryComponent": "YidaComp",
  "requiredDefaultExport": true,
  "allowedImports": [
    "react",
    "react-dom",
    "antd",
    "@ant-design/icons",
    "ahooks",
    "recharts",
    "d3",
    "@radix-ui/themes",
    "lucide-react",
    "framer-motion",
    "yida-plugin-markdown"
  ],
  "forbiddenSourcePatterns": [
    "window.antd",
    "window.React",
    "window.icons",
    "this.utils.yida",
    "this.dataSourceMap",
    "document.cookie",
    "localStorage.getItem('token')"
  ],
  "requiredSourceMarkers": ["data-yida-theme-root=\"true\"", "export default YidaComp"],
  "forbidEmoji": true
}
