{
  "schemaVersion": 1,
  "sourceExtension": ".canvas.jsx",
  "entryComponent": "YidaComp",
  "requiredDefaultExport": true,
  "allowedImports": ["react", "antd", "lucide-react"],
  "forbiddenSourcePatterns": [
    "window.antd",
    "window.React",
    "this.utils.yida",
    "this.dataSourceMap",
    "document.cookie",
    "fetch(",
    ".invoke("
  ],
  "requiredSourceMarkers": [
    "data-yida-theme-root",
    "data-platform-runtime-probe",
    "process-preflight",
    "process-start",
    "lifecycle-inspect",
    "lifecycle-update",
    "lifecycle-approve",
    "lifecycle-terminate",
    "self-only-process",
    "export default YidaComp"
  ],
  "forbidEmoji": true
}
